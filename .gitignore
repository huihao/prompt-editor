# --------------------------------------------
/build/
/dist/
/out/

# --------------------------------------------
# Rust (core/)
# --------------------------------------------
# Compiled files
*.rs.bk
*.rlib
*.rmeta

# Cargo build output
core/target/

# FFI generated files
core/include/*.h
!core/include/.gitkeep

# --------------------------------------------
# Node.js / TypeScript (editor/)
# --------------------------------------------
# Dependencies
editor/node_modules/
node_modules/

# Build outputs
editor/dist/
*.tsbuildinfo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Coverage
editor/coverage/
core/coverage/
coverage/

